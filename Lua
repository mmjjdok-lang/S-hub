	-------------------------------------------------- containers (tabs + sub pages)
	local function newContainer(noSearch)
		local C = {count = 0}
		local page = make("ScrollingFrame", {Size = FULL, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = ACC, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false}, Pages)
		pad(page, 6)
		local function col(x)
			local c = make("Frame", {Position = UDim2.new(x, x == 0 and 0 or 3, 0, 0), Size = UDim2.new(.5, -3, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1}, page)
			list(c, 6); return c
		end
		local L, R = col(0), col(.5)
		C.page, C.noSearch = page, noSearch

		function C:Section(so)
			so = so or {}
			C.count += 1
			local side = so.Side or (C.count % 2 == 1 and "Left" or "Right")
			local Sec = {hits = 0}
			local frame = make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = PANEL, BackgroundTransparency = 0.35}, side == "Left" and L or R)
			corner(frame, 8); stroke(frame, PURPLE, 1, 0.65); pad(frame, 6); list(frame, 4)
			local head = make("TextButton", {Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = ITEM, BackgroundTransparency = 0.4, Text = "  " .. (so.Name or "Section"), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false}, frame)
			corner(head, 6); stroke(head, PINK, 1, 0.6); ripple(head)
			local arrow = make("TextLabel", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -6, .5, 0), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Text = "v", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = SUB}, head)
			local content = make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1}, frame)
			list(content, 4)
			Sec.frame = frame
			function Sec.setOpen(v) content.Visible = v; arrow.Rotation = v and 0 or -90 end
			head.Activated:Connect(function() Sec.setOpen(not content.Visible) end)
			if not noSearch then table.insert(sections, Sec) end

			local function reg(name, f)
				local e = {name = name, frame = f, tab = C, sec = Sec, match = true}
				if not noSearch then
					table.insert(elements, e)
					local g = Sec.group
					if g then
						e.group = g; table.insert(g.members, e); g.left -= 1
						if g.left <= 0 then Sec.group = nil end
					end
				end
				return e
			end
			local function label(p, t, x, w)
				return make("TextLabel", {Position = UDim2.fromOffset(x or 8, 0), Size = UDim2.new(w or 1, -(x or 8) - 4, 1, 0), BackgroundTransparency = 1, Text = t, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, p)
			end

			-- row with mini-picker square + "..." sub page button on the left
			local function styledRow(o, def)
				local flag = o.Flag or o.Name or def
				local row = make("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = ITEM, BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false}, content)
				corner(row, 6)
				local st = stroke(row, Color3.fromRGB(70, 50, 110), 1, 0.6)
				local mini = make("TextButton", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 5, .5, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = BG, BackgroundTransparency = 0.4, Text = "", AutoButtonColor = false}, row)
				corner(mini, 3); stroke(mini, PINK, 1, 0.3)
				local dots = make("TextButton", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 23, .5, 0), Size = UDim2.fromOffset(18, 14), BackgroundTransparency = 1, Text = "...", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = SUB, AutoButtonColor = false}, row)
				local nm = label(row, o.Name or def, 44, 1)
				ripple(row)
				local sk = "style:" .. flag
				local sd = o.NoSave and {} or (flags[sk] or {})
				local entry = reg(o.Name or def, row)
				local function apply()
					row.Size = UDim2.new(1, 0, 0, sd.h or 28)
					row.BackgroundTransparency = sd.t or 0.35
					st.Color = sd.bc and Color3.fromHex(sd.bc) or Color3.fromRGB(70, 50, 110)
					st.Transparency = sd.bt or 0.6
					if sd.n then nm.Text = sd.n; entry.name = sd.n end
				end
				apply()
				mini.Activated:Connect(function() openMini(sd, apply, function() setf(o, sk, sd) end, nm.Text) end)
				local sub
				dots.Activated:Connect(function()
					if not sub then
						sub = Window:SubPage(nm.Text)
						if o.Settings then o.Settings(sub)
						else sub:Section({Name = "Settings"}):Label({Text = "No extra settings yet."}) end
					end
					Window:OpenSub(sub)
				end)
				return row, nm, flag
			end

			function Sec:Label(o) local f = make("Frame", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1}, content); label(f, o.Text or "", 4, 1).TextColor3 = SUB; reg(o.Text or "label", f) return f end
			function Sec:Custom(h, builder) local f = make("Frame", {Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = ITEM, BackgroundTransparency = 0.5, ClipsDescendants = true}, content); corner(f, 6); builder(f); return f end

			function Sec:Collapse(o) -- collapses ONLY the next `Count` elements
				local g = {open = true, members = {}, left = o.Count or 1}
				local f = make("TextButton", {Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = ITEM, BackgroundTransparency = 0.45, Text = "", AutoButtonColor = false}, content)
				corner(f, 6); stroke(f, PINK, 1, 0.5); ripple(f)
				label(f, o.Name or "Group", 8, 1).Font = Enum.Font.GothamBold
				local ar = make("TextLabel", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Text = "v", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = SUB}, f)
				function g.set(v) g.open = v; ar.Rotation = v and 0 or -90 end
				f.Activated:Connect(function() g.set(not g.open); applySearch(Search.Text) end)
				reg(o.Name or "Group", f)
				Sec.group = g
				return g
			end

			function Sec:Button(o)
				local row = styledRow(o, "Button")
				row.Activated:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
			end

			local function switch(parent, val, onToggle)
				local pill = make("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(32, 16), BackgroundColor3 = Color3.fromRGB(50, 50, 60)}, parent)
				corner(pill, 8)
				local knob = make("Frame", {Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1)}, pill)
				corner(knob, 6)
				local state = val
				local function set(v, silent)
					state = v
					tween(pill, .2, {BackgroundColor3 = v and ACC or Color3.fromRGB(50, 50, 60)})
					tween(knob, .2, {Position = v and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)})
					if not silent then onToggle(v) end
				end
				set(val, true)
				return set, function() return state end
			end

			function Sec:Toggle(o)
				local row, nm, flag = styledRow(o, "Toggle")
				nm.Size = UDim2.new(1, -88, 1, 0)
				local val = getf(o, flag, o.Default or false)
				local set, get = switch(row, val, function(v) setf(o, flag, v); if o.Callback then task.spawn(o.Callback, v) end end)
				row.Activated:Connect(function() set(not get()) end)
				if val and o.Callback then task.spawn(o.Callback, true) end
				return {Set = set}
			end

			function Sec:Slider(o)
				local flag = o.Flag or o.Name or "Slider"
				local min, max = o.Min or 0, o.Max or 100
				local f, set = makeSlider(content, o.Name or "Slider", min, max, getf(o, flag, o.Default or min), o.Increment or 1, function(v) setf(o, flag, v); if o.Callback then task.spawn(o.Callback, v) end end)
				reg(o.Name or "Slider", f)
				return {Set = set}
			end

			function Sec:ToggleSlider(o) -- toggle + slider merged in one control
				local flag = o.Flag or o.Name or "ToggleSlider"
				local min, max = o.Min or 0, o.Max or 100
				local f = make("Frame", {Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = ITEM, BackgroundTransparency = 0.35}, content)
				corner(f, 6)
				local top = make("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false}, f)
				ripple(top); label(top, o.Name or "ToggleSlider", 8, 1)
				local state, value = getf(o, flag .. "_on", o.Default or false), getf(o, flag .. "_v", o.Value or min)
				local function fire() if o.Callback then task.spawn(o.Callback, state, value) end end
				local set, get = switch(top, state, function(v) state = v; setf(o, flag .. "_on", v); fire() end)
				top.Activated:Connect(function() set(not get()) end)
				local sl = makeSlider(f, "Value", min, max, value, o.Increment or 1, function(v) value = v; setf(o, flag .. "_v", v); fire() end, 32)
				sl.Position = UDim2.fromOffset(0, 28); sl.BackgroundTransparency = 1
				reg(o.Name or "ToggleSlider", f)
				if state then fire() end
