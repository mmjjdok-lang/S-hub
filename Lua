function Lib:CreateWindow(cfg)
	cfg = cfg or {}
	local Window, conns = {}, {}
	local ACC = cfg.Theme or PURPLE
	local baseTitle = cfg.Title or "S Hub"
	local folder = cfg.Folder or "SGlassUI"
	local path = folder .. "/config.json"
	local flags = {}
	pcall(function() if isfile and isfile(path) then flags = HS:JSONDecode(readfile(path)) end end)
	Window.Flags = flags

	local saving = false
	local function save()
		if saving then return end
		saving = true
		task.delay(0.4, function()
			saving = false
			pcall(function()
				if writefile then
					if makefolder and not isfolder(folder) then makefolder(folder) end
					writefile(path, HS:JSONEncode(flags))
				end
			end)
		end)
	end
	local function bind(sig, fn) local c = sig:Connect(fn); table.insert(conns, c); return c end
	local function getf(o, k, d) if o.NoSave then return d end local v = flags[k]; if v == nil then return d end return v end
	local function setf(o, k, v, silent) if o.NoSave then return end flags[k] = v; if not silent then save() end end

	local Gui = make("ScreenGui", {Name = "SGlassUI", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100}, guiParent())
	local PopGui = make("ScreenGui", {Name = "SGlassPop", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 200}, guiParent())
	Gui.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end PopGui:Destroy() end)

	-- drag helpers (single finger / single pointer only)
	local function dragArea(frame, fn)
		local drag
		bind(frame.InputBegan, function(i)
			if not drag and (i.UserInputType == MB1 or i.UserInputType == TOUCH) then drag = i; fn(i.Position.X, i.Position.Y) end
		end)
		bind(UIS.InputChanged, function(i)
			if not drag then return end
			if i == drag then fn(i.Position.X, i.Position.Y)
			elseif i.UserInputType == Enum.UserInputType.MouseMovement and drag.UserInputType == MB1 then local m = mousePos(); fn(m.X, m.Y) end
		end)
		bind(UIS.InputEnded, function(i)
			if drag and (i == drag or (drag.UserInputType == MB1 and i.UserInputType == MB1)) then drag = nil end
		end)
	end
	local function draggable(handle, target, enabled, onEnd)
		local active, startMouse, startPos, moved
		bind(handle.InputBegan, function(i)
			if active or (enabled and not enabled()) then return end
			if i.UserInputType == MB1 or i.UserInputType == TOUCH then
				active, moved = i, false
				startMouse, startPos = Vector2.new(i.Position.X, i.Position.Y), target.Position
				target:SetAttribute("Dragged", false)
			end
		end)
		bind(UIS.InputChanged, function(i)
			if not active then return end
			local p
			if i == active then p = Vector2.new(i.Position.X, i.Position.Y)
			elseif i.UserInputType == Enum.UserInputType.MouseMovement and active.UserInputType == MB1 then p = mousePos()
			else return end
			local d = p - startMouse
			if d.Magnitude > 6 then moved = true; target:SetAttribute("Dragged", true) end
			if moved then tween(target, 0.09, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)}) end
		end)
		bind(UIS.InputEnded, function(i)
			if active and (i == active or (active.UserInputType == MB1 and i.UserInputType == MB1)) then
				active = nil
				if moved and onEnd then task.delay(0.15, onEnd) end
			end
		end)
	end

