	local gr = make("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, acc), ColorSequenceKeypoint.new(.5, PINK), ColorSequenceKeypoint.new(1, acc)})}, st)
	local conn = RS.RenderStepped:Connect(function(dt) gr.Rotation = (gr.Rotation + dt * 25) % 360 end)
	local ico = make("ImageLabel", {Position = UDim2.fromOffset(14, 12), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, Visible = false, ImageColor3 = TEXT}, f)
	local fb = make("TextLabel", {Position = UDim2.fromOffset(14, 12), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, Text = "S", Font = Enum.Font.GothamBlack, TextSize = 20, TextColor3 = TEXT}, f)
	applyIcon(ico, fb, cfg.Icon)
	make("TextLabel", {Position = UDim2.fromOffset(46, 12), Size = UDim2.new(1, -56, 0, 24), BackgroundTransparency = 1, Text = cfg.Title or "Key System", Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left}, f)
	local status = make("TextLabel", {Position = UDim2.fromOffset(14, 42), Size = UDim2.new(1, -28, 0, 16), BackgroundTransparency = 1, Text = cfg.Note or "Enter your key to continue", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = SUB, TextXAlignment = Enum.TextXAlignment.Left}, f)
	local tb = make("TextBox", {Position = UDim2.fromOffset(14, 68), Size = UDim2.new(1, -28, 0, 32), BackgroundColor3 = ITEM, BackgroundTransparency = 0.3, PlaceholderText = "Key...", PlaceholderColor3 = SUB, Text = "", ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = TEXT}, f)
	corner(tb, 8); stroke(tb, acc, 1, 0.5)
	local function btn(txt, x, w, col)
		local b = make("TextButton", {Position = UDim2.fromOffset(x, 114), Size = UDim2.fromOffset(w, 34), BackgroundColor3 = col, BackgroundTransparency = 0.3, Text = txt, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = TEXT, AutoButtonColor = false}, f)
		corner(b, 8); ripple(b); return b
	end
	local verify, getkey = btn("Verify", 14, 130, acc), btn("Get Key", 156, 130, Color3.fromRGB(60, 60, 75))
	local ev = Instance.new("BindableEvent")
	getkey.Activated:Connect(function()
		if cfg.Url and setclipboard then pcall(setclipboard, cfg.Url); status.Text = "Key link copied to clipboard"; status.TextColor3 = SUB
		else status.Text = cfg.Url or "No link set" end
	end)
	verify.Activated:Connect(function()
		local k = tb.Text:gsub("%s", "")
		if valid[k] then
			if cfg.SaveKey and writefile then pcall(function() if makefolder and not isfolder(folder) then makefolder(folder) end writefile(kp, k) end) end
			conn:Disconnect(); g:Destroy(); ev:Fire()
		else
			status.Text = "Invalid key"; status.TextColor3 = Color3.fromRGB(255, 90, 90)
			for _ = 1, 3 do f.Position = UDim2.new(.5, 8, .5, 0); task.wait(0.04); f.Position = UDim2.new(.5, -8, .5, 0); task.wait(0.04) end
			f.Position = UDim2.fromScale(.5, .5)
		end
	end)
	ev.Event:Wait()
	if cfg.Callback then cfg.Callback() end
	return true
end

