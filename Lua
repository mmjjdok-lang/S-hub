function Lib:Key(cfg)
	cfg = cfg or {}
	local acc = cfg.Theme or PURPLE
	local folder = cfg.Folder or "SGlassUI"
	local kp = folder .. "/key.txt"
	local valid = {}
	local function add(k)
		if type(k) == "string" then valid[k] = true
		elseif type(k) == "table" then for _, x in ipairs(k) do valid[tostring(x)] = true end end
	end
	add(cfg.Key); add(cfg.Keys)
	if cfg.KeyUrl then
		pcall(function() for line in game:HttpGet(cfg.KeyUrl):gmatch("[^\r\n]+") do valid[line] = true end end)
	end
	if cfg.SaveKey and isfile and pcall(isfile, kp) and isfile(kp) then
		local ok, saved = pcall(readfile, kp)
		if ok and valid[saved] then if cfg.Callback then cfg.Callback() end return true end
	end
	local g = make("ScreenGui", {Name = "SGlassKey", ResetOnSpawn = false, DisplayOrder = 300}, guiParent())
	local f = make("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(300, 180), BackgroundColor3 = BG, BackgroundTransparency = 0.08}, g)
