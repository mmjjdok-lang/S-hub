					q = (q or ""):lower()
					for _, c in ipairs(sc:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
					for _, v in ipairs(opts) do
						if q == "" or tostring(v):lower():find(q, 1, true) then
							local b = make("TextButton", {Size = UDim2.new(1, -4, 0, 22), BackgroundColor3 = BG, BackgroundTransparency = 0.4, Text = tostring(v), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT, AutoButtonColor = false}, sc)
							corner(b, 5); ripple(b)
