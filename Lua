		task.spawn(function() local ok, d = pcall(function() return Players:GetHumanoidDescriptionFromUserId(LP.UserId) end); if ok then original = d end end)

		local function hum() local c = LP.Character; return c and c:FindFirstChildOfClass("Humanoid") end
		local function applyDesc(d)
			local h = hum()
			if not h then Window:Notify({Title = "Avatar", Message = "No character found.", Duration = 3}); return false end
			local ok = pcall(function() h:ApplyDescription(d) end)
			if ok then custom = d end
			return ok
		end
		local function editDesc(fn)
			local h = hum()
			if not h then Window:Notify({Title = "Avatar", Message = "No character found.", Duration = 3}); return end
			local ok, d = pcall(function() return h:GetAppliedDescription() end)
			if not ok then return end
			fn(d); applyDesc(d)
		end
		local function setAcc(d, accType, id)
			local new = {}
			for _, a in ipairs(d:GetAccessories(true)) do if a.AccessoryType ~= accType then table.insert(new, a) end end
			table.insert(new, {AssetId = id, AccessoryType = accType, IsLayered = false, Order = #new + 1})
			d:SetAccessories(new, true)
		end
		local ASSETFIELD = {[17] = "Head", [18] = "Face", [27] = "Torso", [28] = "RightArm", [29] = "LeftArm", [30] = "LeftLeg", [31] = "RightLeg", [11] = "Shirt", [12] = "Pants", [2] = "GraphicTShirt", [8] = {"Hat"}, [41] = {"Hair"}, [42] = {"Face"}, [43] = {"Neck"}, [44] = {"Shoulder"}, [45] = {"Front"}, [46] = {"Back"}, [47] = {"Waist"}}
		local function applyBundle(bid)
			local ok, det = pcall(function() return AssetService:GetBundleDetailsAsync(bid) end)
			if not ok or not det then Window:Notify({Title = "Avatar", Message = "Bundle not found.", Duration = 3}); return end
			editDesc(function(d)
				for _, it in ipairs(det.Items) do
					if it.Type == "Asset" then
						local ok2, info = pcall(function() return MPS:GetProductInfo(it.Id) end)
						local f = ok2 and info and ASSETFIELD[info.AssetTypeId]
						if type(f) == "string" then d[f] = it.Id elseif type(f) == "table" then setAcc(d, Enum.AccessoryType[f[1]], it.Id) end
					end
				end
			end)
		end
		local function importSkin(txt)
			txt = (txt:gsub("%s", ""))
			local id = tonumber(txt)
			if not id then
				local ok, r = pcall(function() return Players:GetUserIdFromNameAsync(txt) end)
				if ok then id = r else Window:Notify({Title = "Skin", Message = "User not found.", Duration = 3}); return end
			end
			local ok, d = pcall(function() return Players:GetHumanoidDescriptionFromUserId(id) end)
			if ok and d and applyDesc(d) then Window:Notify({Title = "Skin", Message = "Skin applied.", Duration = 3})
			else Window:Notify({Title = "Skin", Message = "Failed to apply skin.", Duration = 3}) end
		end

		-- effects / auras (50+)
		local FX, FXNAMES = {}, {"None"}
		local COLORS = {{"Red", "FF3B3B"}, {"Orange", "FF8A1F"}, {"Yellow", "FFE14D"}, {"Lime", "8CFF3B"}, {"Green", "2BD968"}, {"Cyan", "2BE3FF"}, {"Blue", "2B6BFF"}, {"Purple", "8A2BE2"}, {"Pink", "FF69B4"}, {"White", "FFFFFF"}}
		local fxConns, backup = {}, {}
		local function clearFx()
			for _, c in ipairs(fxConns) do c:Disconnect() end
			table.clear(fxConns)
			for p, b in pairs(backup) do if p.Parent then p.Material, p.Transparency = b[1], b[2] end end
			table.clear(backup)
			local c = LP.Character
			if c then for _, x in ipairs(c:GetDescendants()) do if x.Name == "SGlassFx" then x:Destroy() end end end
		end
		local function particle(root, col, rate, size)
			return make("ParticleEmitter", {Name = "SGlassFx", Color = ColorSequence.new(col), Rate = rate or 45, Lifetime = NumberRange.new(1, 1.8), Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(360, 360), Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size or .7), NumberSequenceKeypoint.new(1, 0)}), Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)}), LightEmission = 1, Rotation = NumberRange.new(0, 360)}, root)
		end
		local KINDS = {
			Aura = function(c, root, col) particle(root, col); make("PointLight", {Name = "SGlassFx", Color = col, Range = 10, Brightness = 2}, root) end,
			Fire = function(c, root, col) make("Fire", {Name = "SGlassFx", Color = col, SecondaryColor = col:Lerp(Color3.new(1, 1, 1), .4), Heat = 8, Size = 6}, root) end,
			["Sparkle Trail"] = function(c, root, col)
				local a0 = make("Attachment", {Name = "SGlassFx", Position = Vector3.new(0, 1.5, 0)}, root)
				local a1 = make("Attachment", {Name = "SGlassFx", Position = Vector3.new(0, -1.5, 0)}, root)
				make("Trail", {Name = "SGlassFx", Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(col), Lifetime = .7, LightEmission = 1, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})}, root)
			end,
			Glow = function(c, root, col)
				make("Highlight", {Name = "SGlassFx", FillColor = col, FillTransparency = .7, OutlineColor = col, Adornee = c}, c)
				make("PointLight", {Name = "SGlassFx", Color = col, Range = 12, Brightness = 2.5}, root)
			end,
			Orbit = function(c, root, col)
				local parts = {}
				for i = 1, 3 do parts[i] = make("Part", {Name = "SGlassFx", Size = Vector3.new(.5, .5, .5), Material = Enum.Material.Neon, Color = col, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Shape = Enum.PartType.Ball}, c) end
				local t = 0
				table.insert(fxConns, RS.Heartbeat:Connect(function(dt)
					t += dt * 2.2
					if not root.Parent then return end
					for i, p in ipairs(parts) do local a = t + i * 2.094; p.CFrame = root.CFrame * CFrame.new(math.cos(a) * 3.4, math.sin(t + i) * .8, math.sin(a) * 3.4) end
				end))
			end,
		}
		local KORDER = {"Aura", "Fire", "Sparkle Trail", "Glow", "Orbit"}
		for _, cl in ipairs(COLORS) do
			for _, k in ipairs(KORDER) do
				local name = cl[1] .. " " .. k
				FX[name] = function(c, root) KINDS[k](c, root, Color3.fromHex(cl[2])) end
				table.insert(FXNAMES, name)
			end
		end
		local function special(name, fn) FX[name] = fn; table.insert(FXNAMES, name) end
		special("Rainbow Aura", function(c, root)
			local pe = particle(root, Color3.new(1, 1, 1), 60, .8)
			pe.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromHex("FF0000")), ColorSequenceKeypoint.new(.33, Color3.fromHex("00FF00")), ColorSequenceKeypoint.new(.66, Color3.fromHex("0000FF")), ColorSequenceKeypoint.new(1, Color3.fromHex("FF00FF"))})
		end)
		special("Light Pulse", function(c, root)
			local l = make("PointLight", {Name = "SGlassFx", Range = 14, Brightness = 3}, root)
			local t = 0
			table.insert(fxConns, RS.Heartbeat:Connect(function(dt) t += dt; l.Color = Color3.fromHSV((t * .3) % 1, .8, 1); l.Brightness = 2 + math.sin(t * 4) end))
		end)
		special("Void Smoke", function(c, root) make("Smoke", {Name = "SGlassFx", Color = Color3.fromRGB(40, 0, 70), Size = 8, Opacity = .5, RiseVelocity = 2}, root) end)
		special("Neon Body", function(c) for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then backup[p] = {p.Material, p.Transparency}; p.Material = Enum.Material.Neon end end end)
		special("Ghost Body", function(c) for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then backup[p] = {p.Material, p.Transparency}; p.Material = Enum.Material.ForceField; p.Transparency = .35 end end end)
		special("Gold Statue", function(c) for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then backup[p] = {p.Material, p.Transparency}; p.Material = Enum.Material.Metal; p.Color = Color3.fromRGB(255, 200, 60) end end end)
		special("Aurora Trail", function(c, root)
			local a0 = make("Attachment", {Name = "SGlassFx", Position = Vector3.new(0, 2, 0)}, root)
			local a1 = make("Attachment", {Name = "SGlassFx", Position = Vector3.new(0, -2, 0)}, root)
			make("Trail", {Name = "SGlassFx", Attachment0 = a0, Attachment1 = a1, Lifetime = 1.2, LightEmission = 1, Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromHex("2BE3FF")), ColorSequenceKeypoint.new(.5, Color3.fromHex("8A2BE2")), ColorSequenceKeypoint.new(1, Color3.fromHex("FF69B4"))}), Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})}, root)
		end)
