	local function openColor(init, cb)
		if colorPop then colorPop:Destroy() end
		local h, s, v = init:ToHSV()
		local pop = popup(190, 182, "Color")
		colorPop = pop
		local sv = make("Frame", {Position = UDim2.fromOffset(10, 28), Size = UDim2.fromOffset(170, 100), BackgroundColor3 = Color3.fromHSV(h, 1, 1)}, pop)
		corner(sv, 6)
		local wf = make("Frame", {Size = FULL, BackgroundColor3 = Color3.new(1, 1, 1)}, sv); corner(wf, 6)
		make("UIGradient", {Transparency = NumberSequence.new(0, 1)}, wf)
		local bf = make("Frame", {Size = FULL, BackgroundColor3 = Color3.new(0, 0, 0)}, sv); corner(bf, 6)
		make("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0)}, bf)
		local cur = make("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1}, sv)
		corner(cur, 5); stroke(cur, Color3.new(1, 1, 1), 2, 0)
		local hue = make("Frame", {Position = UDim2.fromOffset(10, 134), Size = UDim2.fromOffset(170, 10), BackgroundColor3 = Color3.new(1, 1, 1)}, pop)
		corner(hue, 5)
		local seq = {}
		for i, c in ipairs({"FF0000", "FFFF00", "00FF00", "00FFFF", "0000FF", "FF00FF", "FF0000"}) do seq[i] = ColorSequenceKeypoint.new((i - 1) / 6, Color3.fromHex(c)) end
		make("UIGradient", {Color = ColorSequence.new(seq)}, hue)
		local hc = make("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(h, 0, .5, 0), Size = UDim2.fromOffset(6, 14), BackgroundColor3 = Color3.new(1, 1, 1)}, hue)
		corner(hc, 3)
		local hex = make("TextBox", {Position = UDim2.fromOffset(10, 152), Size = UDim2.fromOffset(170, 22), BackgroundColor3 = ITEM, BackgroundTransparency = 0.3, Text = "", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT, ClearTextOnFocus = false}, pop)
		corner(hex, 5)
		local function upd(fire)
			local c = Color3.fromHSV(h, s, v)
			sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			cur.Position = UDim2.fromScale(s, 1 - v)
			hc.Position = UDim2.new(h, 0, .5, 0)
			hex.Text = "#" .. c:ToHex()
			if fire and cb then cb(c) end
		end
		dragArea(sv, function(x, y)
			s = math.clamp((x - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
			upd(true)
		end)
		dragArea(hue, function(x) h = math.clamp((x - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, .999); upd(true) end)
		hex.FocusLost:Connect(function()
			local ok, c = pcall(Color3.fromHex, hex.Text:gsub("#", ""))
			if ok and c then h, s, v = c:ToHSV(); upd(true) else upd(false) end
		end)
		upd(false)
	end
	Window.PickColor = openColor

	local function makeSlider(parent, name, min, max, val, step, cb, ht)
		step = step or 1
		local f = make("Frame", {Size = UDim2.new(1, 0, 0, ht or 38), BackgroundColor3 = ITEM, BackgroundTransparency = 0.35}, parent)
		corner(f, 6)
		local lb = make("TextLabel", {Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left}, f)
		local bar = make("Frame", {Position = UDim2.new(0, 8, 1, -12), Size = UDim2.new(1, -16, 0, 6), BackgroundColor3 = Color3.fromRGB(50, 50, 60)}, f)
		corner(bar, 3)
		local fill = make("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = ACC}, bar)
		corner(fill, 3)
		local cur = val
		local function set(v, silent)
			v = math.clamp(math.floor(v / step + .5) * step, min, max)
			v = tonumber(("%.3f"):format(v)); cur = v
			fill.Size = UDim2.fromScale((v - min) / math.max(max - min, 1e-6), 1)
			lb.Text = name .. ": " .. tostring(v)
			if not silent and cb then cb(v) end
		end
		dragArea(bar, function(x) set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)) end)
		set(val, true)
		return f, set, function() return cur end
	end

	-- mini picker: quick edit of a button/toggle (name, size, transparency, border color/transparency)
