	local function newOpenVisual(parent)
		local V = {}
		local btn = make("TextButton", {AutoButtonColor = false, Text = "", BackgroundColor3 = BG}, parent)
		local cr = corner(btn, 10)
		local st = make("UIStroke", {ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 1.5}, btn)
		local gr = make("UIGradient", {}, st)
		table.insert(openGrads, gr)
		local inner = make("Frame", {Size = FULL, BackgroundTransparency = 1}, btn)
		local lbl = make("TextLabel", {Size = FULL, BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = TEXT, TextTruncate = Enum.TextTruncate.AtEnd}, inner)
		local img = make("ImageLabel", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(.55, .55), BackgroundTransparency = 1, Visible = false, ImageColor3 = TEXT}, inner)
		ripple(btn)
		V.btn = btn
		function V.apply(o)
			local sh = shapes[o.Shape] or shapes.Rounded
			local w, h = o.W, o.H
			V.fixed = false
			if sh.sq then local s = math.min(w, h); w, h = s, s else w, h = w * sh.w, h * sh.h end
			if sh.circ and o.W == 30 and o.H == 30 then w, h = 26, 26; V.fixed = true end -- 30x30 circle: pinned top-left, slightly smaller
			btn.Size = UDim2.fromOffset(w, h)
			cr.CornerRadius = UDim.new(0, sh.r)
			btn.Rotation, inner.Rotation = sh.rot, -sh.rot
			btn.BackgroundColor3, btn.BackgroundTransparency = Color3.fromHex(o.FC), o.FT
			st.Color, st.Transparency = Color3.fromHex(o.BC), o.BT
			gr.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromHex(o.C1)), ColorSequenceKeypoint.new(.5, Color3.fromHex(o.C2)), ColorSequenceKeypoint.new(1, Color3.fromHex(o.C3))})
			lbl.Text = w < 40 and o.Name:sub(1, 1) or o.Name
			if o.Icon then applyIcon(img, lbl, o.Icon) end
		end
		return V
	end

