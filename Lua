								editDesc(function(d)
									if it[2] == "f" then d[it[3]] = id
									elseif it[2] == "a" then setAcc(d, Enum.AccessoryType[it[3]], id)
									else setAcc(d, Enum.AccessoryType.LeftShoe, id); setAcc(d, Enum.AccessoryType.RightShoe, id) end
								end)
							end)
						end})
					end
				end
			end
			Window:OpenSub(hub)
		end})
		return tab
	end

	Window.Save = save
	Window.Gui = Gui
	return Window
end

return Lib

