			function Sec:TextBox(o)
				local flag = o.Flag or o.Name or "TextBox"
				local f = make("Frame", {Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = ITEM, BackgroundTransparency = 0.35}, content)
				corner(f, 6)
