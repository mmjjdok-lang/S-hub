	-------------------------------------------------- state: tabs / subpages / search
	local tabs, elements, sections = {}, {}, {}
	local current, activeSub

	local function leaveSub()
		if activeSub then activeSub.page.Visible = false; activeSub = nil end
		backBtn.Visible = false; titleLbl.Text = baseTitle
	end
	local function selectTab(t)
		leaveSub()
		current = t
		for _, x in ipairs(tabs) do
			x.page.Visible = (x == t)
			tween(x.btn, 0.2, {BackgroundTransparency = x == t and 0.2 or 0.85, BackgroundColor3 = x == t and ACC or ITEM})
		end
	end
	function Window:OpenSub(sub)
		if current then current.page.Visible = false end
		if activeSub then activeSub.page.Visible = false end
		activeSub = sub; sub.page.Visible = true
		backBtn.Visible = true; titleLbl.Text = sub.title or baseTitle
	end
	backBtn.Activated:Connect(function() leaveSub(); if current then current.page.Visible = true end end)

	local function applySearch(q)
		q = (q or ""):lower()
		local firstTab
		for _, s in ipairs(sections) do s.hits = 0 end
		for _, e in ipairs(elements) do
			e.match = q == "" or e.name:lower():find(q, 1, true) ~= nil
			if e.match and q ~= "" then
				if e.group and not e.group.open then e.group.set(true) end
				e.sec.setOpen(true)
				firstTab = firstTab or e.tab
			end
		end
		for _, e in ipairs(elements) do
			local vis = e.match and (e.group == nil or e.group.open)
			e.frame.Visible = vis
			if vis then e.sec.hits += 1 end
		end
		for _, s in ipairs(sections) do s.frame.Visible = q == "" or s.hits > 0 end
		if firstTab and (firstTab ~= current or activeSub) then selectTab(firstTab) end
	end
	Search:GetPropertyChangedSignal("Text"):Connect(function() applySearch(Search.Text) end)

