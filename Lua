				local tb = make("TextBox", {Position = UDim2.fromOffset(8, 20), Size = UDim2.new(1, -16, 0, 20), BackgroundColor3 = BG, BackgroundTransparency = 0.3, PlaceholderText = o.Placeholder or "", PlaceholderColor3 = SUB, Text = getf(o, flag, o.Default or ""), ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT}, f)
				corner(tb, 5)
				tb.FocusLost:Connect(function() click(); setf(o, flag, tb.Text); if o.Callback then task.spawn(o.Callback, tb.Text) end end)
				reg(o.Name or "TextBox", f)
				return tb
			end

			function Sec:ColorPicker(o)
				local flag = o.Flag or o.Name or "Color"
				local color = Color3.fromHex(getf(o, flag, (o.Default or PURPLE):ToHex()))
				local row = make("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = ITEM, BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false}, content)
				corner(row, 6); ripple(row); label(row, o.Name or "Color", 8, 1)
				local sw = make("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(30, 16), BackgroundColor3 = color}, row)
				corner(sw, 4); stroke(sw, Color3.new(1, 1, 1), 1, 0.5)
				row.Activated:Connect(function()
					openColor(color, function(c) color = c; sw.BackgroundColor3 = c; setf(o, flag, c:ToHex()); if o.Callback then task.spawn(o.Callback, c) end end)
				end)
				reg(o.Name or "Color", row)
				if o.Callback then task.spawn(o.Callback, color) end
