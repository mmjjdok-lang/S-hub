						end
					end
				end
				refresh(); set(sel, true)
				sb:GetPropertyChangedSignal("Text"):Connect(function() refresh(sb.Text) end)
				head.Activated:Connect(function() panel.Visible = not panel.Visible end)
				reg(o.Name or "Dropdown", f)
				if sel ~= nil and o.Callback then task.spawn(o.Callback, sel) end
				return {Set = set, Refresh = function(n) opts = n; refresh() end}
			end
			return Sec
		end
		return C
	end

