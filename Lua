		corner(tb, 6)
		tb.FocusLost:Connect(function() sd.n = tb.Text; apply(); persist() end)
		makeSlider(body, "Size", 20, 44, sd.h or 28, 1, function(v) sd.h = v; apply(); persist() end, 32)
		makeSlider(body, "Transparency", 0, 1, sd.t or 0.35, 0.05, function(v) sd.t = v; apply(); persist() end, 32)
		makeSlider(body, "Border transparency", 0, 1, sd.bt or 0.6, 0.05, function(v) sd.bt = v; apply(); persist() end, 32)
		local cb = make("TextButton", {Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = ITEM, BackgroundTransparency = 0.3, Text = "Border color", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TEXT, AutoButtonColor = false}, body)
