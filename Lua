local IconLib, iconWaiters = nil, {}
task.spawn(function()
	local ok, res = pcall(function() return loadstring(game:HttpGet(ICON_URL))() end)
	if ok and res then IconLib = res; for _, f in ipairs(iconWaiters) do task.spawn(f) end end
end)
local function lookupIcon(name)
	if not IconLib then return nil end
	local ok, a, b, c = pcall(function()
		if type(IconLib.Icon) == "function" then return IconLib.Icon(name)
		elseif type(IconLib.GetIcon) == "function" then return IconLib.GetIcon(name) end
		return IconLib[name]
	end)
	if not ok or a == nil then return nil end
	if type(a) == "string" then return {Image = a, Size = b, Pos = c} end
	if type(a) == "table" then return {Image = a.Image or a[1], Size = a.ImageRectSize or a.Size or a[2], Pos = a.ImageRectPosition or a.Position or a[3]} end
end
local function applyIcon(img, fallback, name)
	if not name then return end
	name = tostring(name)
	local function show() img.Visible = true; if fallback then fallback.Visible = false end end
	if name:find("rbxassetid") or name:match("^%d+$") then
		img.Image = name:match("^%d+$") and ("rbxassetid://" .. name) or name; show(); return
	end
	local function try()
		local r = lookupIcon(name)
		if r and r.Image then
			img.Image = r.Image
			if typeof(r.Size) == "Vector2" then img.ImageRectSize = r.Size end
			if typeof(r.Pos) == "Vector2" then img.ImageRectPosition = r.Pos end
			show()
		end
	end
	try()
	if not img.Visible then table.insert(iconWaiters, try) end
end

-- heavy preloader: batches + yields so the main thread never lags
function Lib.Preload(items, onDone)
	task.spawn(function()
		local batch = {}
		for i, a in ipairs(items) do
			table.insert(batch, a)
			if #batch >= 8 or i == #items then
				pcall(function() CP:PreloadAsync(batch) end)
				batch = {}
				task.wait()
			end
		end
		if onDone then onDone() end
	end)
end
